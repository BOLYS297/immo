# Webhook n8n du workflow "Diagnostic IA" (optionnel : sans lui, l'API renvoie un bilan de démonstration)
N8N_DIAGNOSTIC_WEBHOOK_URL=

# Agent IMMO (Terminal) : sans clé, réponses de repli locales dans le même périmètre
ANTHROPIC_API_KEY=
IMMO_AGENT_MODEL=claude-sonnet-5-5

# --- CMS (Laravel, immo-back) ---
# API Laravel lue côté serveur pour composer les pages (sections, textes FR/EN). Sans elle : textes des dictionnaires.
CMS_API_URL=http://127.0.0.1:8000/api/v1
# Secret partagé avec FRONT_REVALIDATE_SECRET côté Laravel : autorise /api/revalidate à vider le cache après une modification.
REVALIDATE_SECRET=
# Clé envoyée à Laravel avec les formulaires (devis, rendez-vous) : identique à FRONT_API_KEY côté Laravel.
# Les notifications de ces formulaires (email, webhooks n8n) se configurent côté Laravel.
CMS_API_KEY=
# Images de la médiathèque hors du serveur Laravel (S3, R2, CDN) : hôtes séparés par des virgules. Redémarrer next après modification.
MEDIA_HOSTS=

# --- Sessions du portail client ---
# Secret de signature du cookie de session (32+ caractères aléatoires). Obligatoire en production.
SESSION_SECRET=
# Cookie de session « secure » activé par défaut en production. Mettre false uniquement pour un test en HTTP local (next start).
SECURE_COOKIES=

# Aperçu en direct : adresses supplémentaires de l'admin Laravel autorisées à afficher /apercu (séparées par des virgules).
# ADMIN_ORIGINS=https://admin.example.com
